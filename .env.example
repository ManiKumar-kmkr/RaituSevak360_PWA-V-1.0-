# -----------------------------------------------------------------------------
# RaituSevak360 - Global Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env or create workspace-specific .env files.
# NEVER commit sensitive keys to source control.

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/raitusevak360

# Security & JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Ports & Application URLs
PORT=5000
NODE_ENV=development
FRONTEND_API_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:5000/api
ADMIN_API_URL=http://localhost:3001

# AI/ML FastAPI Engine
AI_API_URL=http://localhost:8000/api/v1
VECTOR_DATABASE_URL=http://localhost:6333

# Firebase & Push Notifications (FCM)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google Maps & Geolocation
GOOGLE_MAPS_API_KEY=

# Cloud Storage
CLOUD_STORAGE_KEY=
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=

# Payment Gateway
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
